# EditorConfig — https://editorconfig.org
# Top-most config; stop searching parent directories.
root = true

# --- Defaults for all files ---
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# --- Rust ---
# Matches rustfmt: 4-space indent, LF newlines.
[*.rs]
indent_size = 4
max_line_length = 100

# --- TOML (Cargo.toml, deny.toml, clippy.toml, …) ---
[*.toml]
indent_size = 4

# --- Markdown ---
# Trailing whitespace is significant (hard line break), so keep it.
[*.md]
trim_trailing_whitespace = false

# --- YAML (GitHub workflows, …) ---
[*.{yml,yaml}]
indent_size = 2

# --- JSON / JSONC (devcontainer, VS Code config, …) ---
[*.{json,jsonc}]
indent_size = 2

# --- Shell scripts (git hooks) ---
[*.sh]
indent_size = 4

# --- justfile ---
[{justfile,*.just}]
indent_style = space
indent_size = 4

# --- Makefiles require tabs ---
[Makefile]
indent_style = tab
