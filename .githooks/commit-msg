#!/bin/sh
# .githooks/commit-msg
#
# Enforces Conventional Commits format on the first meaningful line:
#   type(optional-scope)optional-!: description
#
# Valid types: feat | fix | docs | style | refactor | perf
#              test | chore | ci | build | revert
#
# Breaking change: feat(auth)!: drop support for OAuth 1.0
#
# WHY THIS IS A SEPARATE HOOK:
#   The pre-commit hook runs before the commit message exists.  COMMIT_EDITMSG
#   at that stage contains the *previous* commit's message — or a stale editor
#   template — making format validation there unreliable.  The commit-msg hook
#   receives the correct message file path as $1.
#
# Bypasses:
#   SKIP_HOOKS=1    git commit …  — skip all hooks
#   SKIP_MSG=1      git commit …  — skip message format check only
#
# Reference: https://www.conventionalcommits.org/

set -e

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0
[ "${SKIP_MSG:-0}" = "1" ]   && exit 0

# $1 = path to the file that holds the proposed commit message
MSG_FILE="${1:?commit-msg hook: \$1 (message file path) not provided}"
COMMIT_MSG=$(cat "$MSG_FILE")

# Strip comment lines (prefixed with #) and extract the first non-blank line.
FIRST_LINE=$(printf '%s\n' "$COMMIT_MSG" \
    | grep -v '^[[:space:]]*#' \
    | sed '/^[[:space:]]*$/d' \
    | head -1 \
    || true)

# Nothing to validate; git will reject the empty message independently.
[ -z "$FIRST_LINE" ] && exit 0

# Let through git-generated messages that cannot follow the convention.
case "$FIRST_LINE" in
    [Mm]erge\ *|[Ss]quashed\ *|[Ff]ixup\!*|[Rr]evert\ *)
        exit 0
        ;;
esac

# Conventional Commits pattern (POSIX ERE):
#   type  (scope)?  !?  :  <space>  <non-empty description>
CC_RE='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([^)]+\))?(!)?: .+'

if ! printf '%s\n' "$FIRST_LINE" | grep -qE "$CC_RE"; then
    if [ -t 2 ]; then
        R='\033[0;31m' Z='\033[0m'
    else
        R='' Z=''
    fi
    printf "${R}error:${Z}   commit message does not follow Conventional Commits format\n\n" >&2
    cat >&2 << 'HELP'
  Format:   type(scope): short description
            type(scope)!: breaking-change description

  Types:    feat | fix | docs | style | refactor | perf
            test | chore | ci | build | revert

  Examples:
    feat(auth): add OAuth2 login flow
    fix(parser)!: handle empty input strings
    chore: update dependencies
    docs(api): clarify rate-limit response headers
    ci: add cargo-audit step to release workflow

  Reference: https://www.conventionalcommits.org/

HELP
    printf "  Your message:\n    %s\n\n" "$FIRST_LINE" >&2
    printf "  To bypass: SKIP_MSG=1 git commit …\n" >&2
    exit 1
fi
