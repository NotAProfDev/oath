#!/bin/sh
# .githooks/pre-commit
#
# Rejects commits that fail formatting, linting, or safety checks.
#
# Checks performed (in order):
#   1. Branch protection     — no direct commits to main
#   2. Staged size limit      — max 300 additions and 300 deletions independently
#   3. Large file prevention  — staged files ≤ 5 MiB each
#   4. Merge conflict markers — rejects <<<<<<< HEAD in staged files
#   5. Secret scanning        — gitleaks if installed (skips otherwise)
#   6. Formatting             — cargo fmt --check
#   7. Linting                — cargo clippy -D warnings
#
# Bypass env-vars (prefix git commit or export before the command):
#   SKIP_HOOKS=1    — skip all checks below
#   SKIP_SIZE=1     — skip staged-size check
#   SKIP_LARGE=1    — skip large-file check
#   SKIP_SECRETS=1  — skip secret scanning
#   SKIP_FORMAT=1   — skip cargo fmt
#   SKIP_LINT=1     — skip cargo clippy
#   MAX_LINES=N     — override size limit (default 200)

set -e

# ── Global bypass ───────────────────────────────────────────────────────
[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

# ── Colour helpers (only when stderr is a real terminal) ────────────────
if [ -t 2 ]; then
    R='\033[0;31m' Y='\033[1;33m' C='\033[0;36m' G='\033[0;32m' Z='\033[0m'
else
    R='' Y='' C='' G='' Z=''
fi

err()  { printf "${R}error:${Z}   %s\n" "$*" >&2; }
warn() { printf "${Y}warning:${Z} %s\n" "$*" >&2; }
step() { printf "${C}  ▸${Z} %s" "$*"; }
pass() { printf "\n ${G}ok${Z}\n"; }
skip() { printf " ${Y}skip${Z}\n"; }

# ── Scratch space (auto-removed on any exit) ────────────────────────────
SCRATCH=$(mktemp -d) || { err "mktemp -d failed"; exit 1; }
trap 'rm -rf "$SCRATCH"' EXIT INT TERM

# ════════════════════════════════════════════════════════════════════════
# 1. Branch protection
# ════════════════════════════════════════════════════════════════════════
step "branch protection"
BRANCH=$(git symbolic-ref HEAD 2>/dev/null || echo "")
case "$BRANCH" in
    refs/heads/main|refs/heads/master)
        echo "" >&2
        err "direct commits to '${BRANCH#refs/heads/}' are not allowed"
        printf "         Hint: git checkout -b feat/your-change\n" >&2
        exit 1
        ;;
esac
pass

# ════════════════════════════════════════════════════════════════════════
# 2. Staged size limit
# ════════════════════════════════════════════════════════════════════════
if [ "${SKIP_SIZE:-0}" != "1" ]; then
    MAX_LINES="${MAX_LINES:-300}"
    step "staged size (≤ ${MAX_LINES} added / ≤ ${MAX_LINES} deleted)"

    # Use --cached for the full index diff. Binary files report '-' in numstat;
    # the awk guard ($1~/^[0-9]+$/) skips them.
    NUMSTAT=$(git diff --cached --numstat 2>/dev/null)

    ADDED=$(printf '%s\n' "$NUMSTAT" | awk '$1~/^[0-9]+$/{s+=$1} END{print s+0}')
    DELETED=$(printf '%s\n' "$NUMSTAT" | awk '$2~/^[0-9]+$/{d+=$2} END{print d+0}')

    if [ "$ADDED" -gt "$MAX_LINES" ] || [ "$DELETED" -gt "$MAX_LINES" ]; then
        echo "" >&2
        err "staged diff exceeds ${MAX_LINES}-line limit  (+${ADDED} added / -${DELETED} deleted)"
        printf "         Top files by change volume:\n" >&2
        printf '%s\n' "$NUMSTAT" \
            | awk '$1~/^[0-9]+$/ { print $1+$2, $1, $2, $3 }' \
            | sort -rn | head -10 \
            | awk '{ printf "           +%-5s -%-5s %s\n", $2, $3, $4 }' >&2
        printf "\n         Split into smaller commits (≤ ~%s lines added/deleted each).\n" "$MAX_LINES" >&2
        printf "         To bypass: SKIP_SIZE=1 git commit …\n" >&2
        exit 1
    fi
    pass
fi

# ════════════════════════════════════════════════════════════════════════
# 3. Large file prevention (staged files only)
# ════════════════════════════════════════════════════════════════════════
if [ "${SKIP_LARGE:-0}" != "1" ]; then
    MAX_SIZE=5242880  # 5 MiB in bytes
    step "large file check (≤ 5 MiB)"

    for file in $(git diff --cached --name-only --diff-filter=AM); do
        size=$(wc -c <"$file" 2>/dev/null || echo 0)
        if [ "$size" -gt "$MAX_SIZE" ]; then
            echo "" >&2
            err "staged file '$file' exceeds 5 MiB limit ($(( size / 1048576 )) MiB)"
            printf "         Consider using git-lfs for large files or removing them from staging.\n" >&2
            exit 1
        fi
    done
    pass
fi

# ════════════════════════════════════════════════════════════════════════
# 4. Merge conflict markers
# ════════════════════════════════════════════════════════════════════════
step "merge conflict check"

# Exclude .githooks/ itself to avoid false positives from the hook's own search string.
if git grep -n '<<<<<<< HEAD' ':!.githooks/' 2>/dev/null; then
    echo "" >&2
    err "merge conflict markers detected in staged files"
    printf "         Resolve conflicts before committing.\n" >&2
    exit 1
fi
pass

# ════════════════════════════════════════════════════════════════════════
# 5. Secret scanning (gitleaks if installed)
# ════════════════════════════════════════════════════════════════════════
if [ "${SKIP_SECRETS:-0}" != "1" ]; then
    step "secret scanning"
    if command -v gitleaks >/dev/null 2>&1; then
        if ! gitleaks protect --staged --verbose >"$SCRATCH/gitleaks.txt" 2>&1; then
            echo "" >&2
            err "potential secret detected in staged changes"
            cat "$SCRATCH/gitleaks.txt" >&2
            printf "\n         To bypass: SKIP_SECRETS=1 git commit …\n" >&2
            exit 1
        fi
    else
        skip
        warn "gitleaks not installed - skipping secret scan (install via apt-get install gitleaks)"
    fi
fi

# ════════════════════════════════════════════════════════════════════════
# 6. Formatting check
# ════════════════════════════════════════════════════════════════════════
if [ "${SKIP_FORMAT:-0}" != "1" ]; then
    step "cargo fmt"
    if ! command -v cargo >/dev/null 2>&1; then
        skip
        warn "cargo not found - skipping fmt check"
    else
        FMT_LOG="$SCRATCH/fmt.txt"
        if ! cargo fmt --all -- --check >"$FMT_LOG" 2>&1; then
            echo "" >&2
            err "cargo fmt check failed - run: cargo fmt --all"
            cat "$FMT_LOG" >&2
            printf "\n         To bypass: SKIP_FORMAT=1 git commit …\n" >&2
            exit 1
        fi
        pass
    fi
fi

# ════════════════════════════════════════════════════════════════════════
# 7. Linting check
# ════════════════════════════════════════════════════════════════════════
if [ "${SKIP_LINT:-0}" != "1" ]; then
    step "cargo clippy"
    if ! command -v cargo >/dev/null 2>&1; then
        skip
        warn "cargo not found - skipping clippy check"
    else
        CLIPPY_LOG="$SCRATCH/clippy.txt"
        # No --all-features or --all-targets for speed. CI runs the full suite.
        if ! cargo clippy --workspace -- -D warnings >"$CLIPPY_LOG" 2>&1; then
            echo "" >&2
            err "cargo clippy reported warnings or errors"
            cat "$CLIPPY_LOG" >&2
            printf "\n         To bypass: SKIP_LINT=1 git commit …\n" >&2
            exit 1
        fi
        pass
    fi
fi
